# Server-side environment variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Discord OAuth2
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.vercel.app/auth/discord/callback
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# Discord Webhooks (for application notifications)
# To create a webhook:
# 1. Go to your Discord server
# 2. Go to Server Settings → Integrations → Webhooks
# 3. Create a new webhook in the channel you want (ID: 1538448096072179772)
# 4. Copy the webhook URL and paste it below
# Format: https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
DISCORD_WEBHOOK_1538448096072179772=https://discord.com/api/webhooks/1538449215485771847/CbI9yBh477KzVmwyWW78mTmoNg7ykiYtxh8NehSLmD_Ed2Qtm55nm5yesPmNZhJ8Dds3

# At least 32 characters; keep this secret and never commit it.
SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Local development only; Vercel manages its own port.
PORT=3000
